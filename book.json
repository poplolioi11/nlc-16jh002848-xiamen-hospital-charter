  "units": [
    {
      "id": "line-p033-c01",
      "page_id": "page-33",
      "section": "charter",
      "column": 1,
      "text": "厦門中山醫院董事會組織大綱",
      "role": "heading",
      "article": null,
      "xywh": [
        651,
        272,
        48,
        505
      ]
    },
    {
      "id": "line-p033-c02",
      "page_id": "page-33",
      "section": "charter",
      "column": 2,
      "text": "第一條本會定名為厦門中山醫院董事會",
      "role": "body",
      "article": 1,
      "xywh": [
        598,
        196,
        42,
        453
      ]
    },
    {
      "id": "line-p033-c03",
      "page_id": "page-33",
      "section": "charter",
      "column": 3,
      "text": "第二條本會由厦門市衛生會執行委員會選出七人為董事凡熱心捐助本院一萬元以上",
      "role": "body",
      "article": 2,
      "xywh": [
        552,
        196,
        42,
        921
      ],
      "editorial_note": "原圖金額只有一完整橫筆。同欄的「第二條」有兩完整橫筆。"
    },
    {
      "id": "line-p033-c04",
      "page_id": "page-33",
      "section": "charter",
      "column": 4,
      "text": "者得為本院董事捐助五萬元以上者得為本院永久董事",
      "role": "body",
      "article": 2,
      "xywh": [
        507,
        294,
        42,
        588
      ]
    },
    {
      "id": "line-p033-c05",
      "page_id": "page-33",
      "section": "charter",
      "column": 5,
      "text": "第三條本會得由全體董事中推出五人組織常務董事會辦理日常事務",
      "role": "body",
      "article": 3,
      "xywh": [
        461,
        196,
        42,
        757
      ]
    },
    {
      "id": "line-p033-c06",
      "page_id": "page-33",
      "section": "charter",
      "column": 6,
      "text": "第四條本會為本院最高機關有監督全院行政之權及籌措經費之責任",
      "role": "body",
      "article": 4,
      "xywh": [
        414,
        196,
        42,
        753
      ]
    },
    {
      "id": "line-p033-c07",
      "page_id": "page-33",
      "section": "charter",
      "column": 7,
      "text": "第五條本院董事任期一年（永久董事得永久連任）",
      "role": "body",
      "article": 5,
      "xywh": [
        370,
        196,
        42,
        548
      ]
    },
    {
      "id": "line-p033-c08",
      "page_id": "page-33",
      "section": "charter",
      "column": 8,
      "text": "第六條本會每星期開常務董事會一次每兩月開全體董事會一次遇必要時得由常務董",
      "role": "body",
      "article": 6,
      "xywh": [
        325,
        196,
        42,
        926
      ]
    },
    {
      "id": "line-p033-c09",
      "page_id": "page-33",
      "section": "charter",
      "column": 9,
      "text": "事會召集之",
      "role": "body",
      "article": 6,
      "xywh": [
        279,
        294,
        42,
        130
      ]
    },
    {
      "id": "line-p033-c10",
      "page_id": "page-33",
      "section": "charter",
      "column": 10,
      "text": "第七條本院董事概為義務職至聘任職員當視事務之繁簡而酌定之",
      "role": "body",
      "article": 7,
      "xywh": [
        234,
        196,
        42,
        724
      ]
    },
    {
      "id": "line-p033-c11",
      "page_id": "page-33",
      "section": "charter",
      "column": 11,
      "text": "第八條本組織大綱如有未妥善處得由全體董事會議決修改之",
      "role": "body",
      "article": 8,
      "xywh": [
        188,
        196,
        42,
        673
      ]
    },
